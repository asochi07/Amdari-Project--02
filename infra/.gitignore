# Terraform working files
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Variable files that may hold secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Plan output files
*.tfplan

# Keep the lock file (it SHOULD be committed)
!.terraform.lock.hcl

# Plan artifacts (may contain sensitive values - never commit)
plan.json
tfplan.bin
*.tfplan
day9-plan.txt

# Lambda build artifact (regenerated by archive_file on plan/apply)
modules/observability/lambda/*.zip
